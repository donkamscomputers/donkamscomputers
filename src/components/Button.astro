---
interface Props {
  href?: string;
  variant?: 'primary' | 'accent' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  block?: boolean;
  icon?: 'arrow' | 'whatsapp' | 'none';
  type?: 'button' | 'submit';
  target?: string;
  rel?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  block = false,
  icon = 'none',
  type = 'button',
  target,
  rel,
  ariaLabel,
} = Astro.props;

const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${size}`,
  block ? 'btn--block' : '',
].filter(Boolean).join(' ');

const Tag = href ? 'a' : 'button';
const attrs = href
  ? { href, target, rel }
  : { type };
---

<Tag class={classes} aria-label={ariaLabel} {...attrs}>
  <span class="btn__label"><slot /></span>

  {icon === 'arrow' && (
    <svg class="btn__icon" width="14" height="14" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14" />
      <path d="m12 5 7 7-7 7" />
    </svg>
  )}

  {icon === 'whatsapp' && (
    <svg class="btn__icon" width="16" height="16" viewBox="0 0 24 24"
         fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
    </svg>
  )}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: var(--fw-semi);
    line-height: 1;
    white-space: nowrap;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
    text-align: center;
  }

  /* ---------- SIZES ---------- */
  .btn--sm { padding: 10px 16px; font-size: var(--fs-small); }
  .btn--md { padding: 12px 20px; font-size: var(--fs-small); }
  .btn--lg { padding: 16px 28px; font-size: var(--fs-body); }

  /* ---------- VARIANTS ---------- */
  .btn--primary {
    background: var(--color-black);
    color: var(--color-ink-invert);
    border-color: var(--color-black);
  }
  .btn--primary:hover {
    background: var(--color-teal);
    border-color: var(--color-teal);
    transform: translateY(-1px);
  }
  .btn--primary:active { transform: translateY(0); }

  .btn--accent {
    background: var(--color-teal);
    color: var(--color-ink-invert);
    border-color: var(--color-teal);
  }
  .btn--accent:hover {
    background: var(--color-teal-hover);
    border-color: var(--color-teal-hover);
    transform: translateY(-1px);
  }
  .btn--accent:active { transform: translateY(0); }

  .btn--secondary {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-border-strong);
  }
  .btn--secondary:hover {
    background: var(--color-ink);
    color: var(--color-ink-invert);
    border-color: var(--color-ink);
    transform: translateY(-1px);
  }
  .btn--secondary:active { transform: translateY(0); }

  .btn--ghost {
    background: transparent;
    color: var(--color-ink);
    border-color: transparent;
    padding-left: 0;
    padding-right: 0;
  }
  .btn--ghost:hover { color: var(--color-teal); }
  .btn--ghost .btn__icon {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn--ghost:hover .btn__icon { transform: translateX(3px); }

  /* ---------- BLOCK ---------- */
  .btn--block { width: 100%; }

  /* ---------- ICON ---------- */
  .btn__icon { flex-shrink: 0; }

  /* ---------- REDUCED MOTION ---------- */
  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn__icon { transition: none; }
    .btn:hover { transform: none; }
  }
</style>