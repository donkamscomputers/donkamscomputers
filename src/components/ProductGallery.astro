---
interface Props {
  images: string[];
  name: string;
}

const { images, name } = Astro.props;

// Fallback: if no gallery, use the primary image
const gallery = images.length > 0 ? images : ['/images/product-placeholder.svg'];
const hasMultiple = gallery.length > 1;
---

<div class="gallery" data-gallery>
  <!-- Main image (mobile: swipeable) -->
  <div class="gallery__main" data-gallery-main>
    {gallery.map((src, i) => (
      <img
        src={src}
        alt={`${name} — image ${i + 1}`}
        class:list={['gallery__image', { 'is-active': i === 0 }]}
        data-gallery-image
        data-index={i}
        onerror="this.onerror=null; this.src='/images/product-placeholder.svg';"
        loading={i === 0 ? 'eager' : 'lazy'}
        decoding="async"
        width="800"
        height="800"
      />
    ))}
  </div>

  <!-- Mobile dots -->
  {hasMultiple && (
    <div class="gallery__dots" data-gallery-dots aria-hidden="true">
      {gallery.map((_, i) => (
        <span class:list={['gallery__dot', { 'is-active': i === 0 }]} />
      ))}
    </div>
  )}

  <!-- Desktop thumbnails -->
  {hasMultiple && (
    <div class="gallery__thumbs" data-gallery-thumbs>
      {gallery.map((src, i) => (
        <button
          type="button"
          class:list={['gallery__thumb', { 'is-active': i === 0 }]}
          data-gallery-thumb
          data-index={i}
          aria-label={`View image ${i + 1}`}
        >
          <img src={src} alt="" loading="lazy" decoding="async" width="120" height="120" onerror="this.onerror=null; this.src='/images/product-placeholder.svg';" />
        </button>
      ))}
    </div>
  )}
</div>

<style>
  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* ---------- MAIN ---------- */
  .gallery__main {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .gallery__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    pointer-events: none;
  }

  .gallery__image.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  /* ---------- DOTS (mobile) ---------- */
  .gallery__dots {
    display: none;
    justify-content: center;
    gap: 6px;
  }

  .gallery__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-border-strong);
    transition: background var(--dur-fast) var(--ease-out),
                width var(--dur-fast) var(--ease-out);
  }

  .gallery__dot.is-active {
    background: var(--color-ink);
    width: 20px;
    border-radius: var(--radius-full);
  }

  /* ---------- THUMBS (desktop) ---------- */
  .gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .gallery__thumb {
    aspect-ratio: 1 / 1;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__thumb:hover { border-color: var(--color-border-strong); }
  .gallery__thumb.is-active { border-color: var(--color-ink); }

  /* ---------- MOBILE ---------- */
  @media (max-width: 768px) {
    .gallery__thumbs { display: none; }
    .gallery__dots { display: flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__image,
    .gallery__dot,
    .gallery__thumb { transition: none; }
  }
</style>

<script>
  const galleries = document.querySelectorAll<HTMLElement>('[data-gallery]');

  galleries.forEach((gallery) => {
    const images = gallery.querySelectorAll<HTMLElement>('[data-gallery-image]');
    const thumbs = gallery.querySelectorAll<HTMLElement>('[data-gallery-thumb]');
    const dots = gallery.querySelectorAll<HTMLElement>('.gallery__dot');
    const main = gallery.querySelector<HTMLElement>('[data-gallery-main]');

    if (images.length <= 1) return;

    let current = 0;
    let startX = 0;
    let isDragging = false;

    function setActive(index: number) {
      current = index;
      images.forEach((img, i) => img.classList.toggle('is-active', i === index));
      thumbs.forEach((th, i) => th.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    }

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const idx = Number(thumb.dataset.index ?? 0);
        setActive(idx);
      });
    });

    // Swipe on mobile
    main?.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      isDragging = true;
    }, { passive: true });

    main?.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      isDragging = false;
      const endX = e.changedTouches[0].clientX;
      const delta = endX - startX;
      const threshold = 40;

      if (Math.abs(delta) < threshold) return;

      if (delta < 0 && current < images.length - 1) {
        setActive(current + 1);
      } else if (delta > 0 && current > 0) {
        setActive(current - 1);
      }
    });
  });
</script>