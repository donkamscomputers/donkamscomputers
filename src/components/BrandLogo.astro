---
interface Brand {
  slug: string;
  name: string;
  logo?: string;
  productPath?: string;
}

interface Props {
  brand: Brand;
  showName?: boolean;
}

const { brand, showName = false } = Astro.props;
const href = brand.productPath ?? `/brands/${brand.slug}`;
---

<a href={href} class="brand-logo" aria-label={brand.name}>
  {brand.logo && (
    <img
      src={brand.logo}
      alt={brand.name}
      width="120"
      height="40"
      loading="lazy"
      decoding="async"
      class="brand-logo__img"
    />
  )}
  {showName && <span class="brand-logo__name">{brand.name}</span>}
</a>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 8px;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
  }

  .brand-logo:hover {
    color: var(--color-ink);
    transform: translateY(-1px);
  }

  .brand-logo__img {
    max-height: 32px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1) opacity(0.7);
    transition: filter var(--dur-fast) var(--ease-out);
  }

  .brand-logo:hover .brand-logo__img {
    filter: grayscale(0) opacity(1);
  }

  .brand-logo__name {
    font-size: var(--fs-small);
    font-weight: var(--fw-semi);
  }
</style>