.whatsapp-link:hover {
  transform: scale(1.06);
}

  .product-info {
    padding: 16px;
  }

  .product-name {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--fs-body);
    line-height: 1.4;
    font-weight: var(--fw-semi);
  }

  .product-condition {
    margin: 8px 0 0;
    color: var(--color-ink-muted);
    font-size: var(--fs-small);
  }

  .product-price {
    margin: 12px 0 0;
    color: var(--color-ink);
    font-size: var(--fs-small);
    font-weight: var(--fw-semi);
  }
</style>