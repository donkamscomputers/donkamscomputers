---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductCard from '../components/ProductCard.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import products from '../data/products.json';
import '../styles/homepage.css';
import { readdirSync, existsSync } from 'node:fs';
import { join } from 'node:path';

const galleryDir = join(process.cwd(), 'public/images/gallery');
const videoDir = join(process.cwd(), 'public/videos');

const galleryPhotos = existsSync(galleryDir)
  ? readdirSync(galleryDir)
      .filter((file) => /\.(webp|jpg|jpeg|png)$/i.test(file))
      .slice(0, 5)
  : [];

const galleryVideos = existsSync(videoDir)
  ? readdirSync(videoDir)
      .filter((file) => /\.(mp4|webm|mov)$/i.test(file))
      .slice(0, 3)
  : [];

// ----- Hero -----
const heroEyebrow = 'Technology. Connectivity. Everyday.';
const heroTitle = 'Phones, Laptops & Starlink in Minna';
const heroSubtitle =
  'Shop phones, laptops, Starlink internet equipment and gaming products at Donkams Computers in Minna, Niger State. Our range includes iPhones, Samsung Galaxy phones, HP and Dell laptops, MacBooks, Google Pixel phones and Starlink kits. Visit our stores in Minna or contact Donkams to confirm current stock, condition and pricing.';

// ----- Hero image -----
const heroImages = [
  '/images/hero-composition.webp',
  '/images/hero-composition2.webp',
  '/images/hero-composition3.webp',
  '/images/hero-composition4.webp',
];

// ----- Featured products -----
const featuredSlugs = [
  'iphone-17-256gb',
  'samsung-s25-ultra-256gb',
  'hp-elitebook-x360-1030-g7-i5',
  'dell-latitude-7420-i7',
  'macbook-air-m1-8-256',
  'starlink-standard-gen4',
  'playstation-5',
  'google-pixel-9-pro-256gb',
];

const featuredProducts = featuredSlugs
  .map((slug) => products.find((product) => product.slug === slug))
  .filter(
    (product): product is (typeof products)[number] => Boolean(product)
  );

// ----- WhatsApp -----
const whatsappNumber = '2348067397482';

const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  "Hi Donkams, I'd like to ask about a product."
)}`;
---

<BaseLayout title="Donkams Computers | Phones, Laptops & Starlink in Minna">
  <section class="hero">
    <HeroCarousel images={heroImages} />

    <div class="hero__content">
      <p class="hero__eyebrow">{heroEyebrow}</p>

      <h1 class="hero__title">{heroTitle}</h1>

      <p class="hero__subtitle">{heroSubtitle}</p>

      <div class="hero__actions">
        <Button href="#featured" variant="primary" size="lg" icon="arrow">
          Explore Products
        </Button>

        <Button
          href={whatsappLink}
          variant="secondary"
          size="lg"
          target="_blank"
          rel="noopener"
        >
          Talk to Donkams
        </Button>
      </div>
    </div>
  </section>

  <section class="featured" id="featured">
    <div class="container">
      <div class="featured__head">
        <div>
          <h2 class="featured__title">
            Featured Phones, Laptops, Starlink & Gaming Products
          </h2>
        </div>

        <br />

        <a href="/products" class="featured__more">
          View More Products <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="featured__grid">
        {featuredProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <section class="inside-donkams" id="inside-donkams">
    <div class="container">
      <div class="inside-donkams__head">
        <p class="text-label">Inside Donkams</p>

        <h2 class="inside-donkams__title">
          Experience Donkams Computers
        </h2>
      </div>

      {galleryPhotos.length > 0 || galleryVideos.length > 0 ? (
        <div class="inside-donkams__media">
          {galleryPhotos.map((file) => (
            <figure class="inside-donkams__photo">
              <button
                type="button"
                class="gallery-photo-button"
                aria-label="Open Inside Donkams photo"
                data-gallery-image={`/images/gallery/${file}`}
              >
                <img
                  src={`/images/gallery/${file}`}
                  alt="Inside Donkams Computers"
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </figure>
          ))}

          {galleryVideos.map((file) => (
            <figure class="inside-donkams__video">
              <video controls preload="metadata" playsinline>
                <source src={`/videos/${file}`} />
              </video>
            </figure>
          ))}
        </div>
      ) : (
        <div class="inside-donkams__empty">
          <strong>Your gallery is ready.</strong>

          <p>
            Add up to 5 photos to
            <code>public/images/gallery/</code>
            and up to 3 videos to
            <code>public/videos/</code>.
            They will appear here automatically.
          </p>
        </div>
      )}
    </div>
  </section>

  <section class="convert" id="contact-cta">
    <div class="container">
      <div class="convert__inner">
        <div>
          <p class="text-label">Need help choosing?</p>

          <h2 class="convert__title">Talk to Donkams.</h2>

          <p class="convert__text">
            Contact us for current stock, condition and availability.
          </p>
        </div>

        <Button href="/contact" variant="primary" icon="arrow">
          Contact Donkams
        </Button>
      </div>
    </div>
  </section>

  <!-- Gallery Lightbox -->
  <div
    class="gallery-lightbox"
    id="gallery-lightbox"
    aria-hidden="true"
  >
    <button
      type="button"
      class="gallery-lightbox__close"
      id="gallery-lightbox-close"
      aria-label="Close image"
    >
      ×
    </button>

    <img
      class="gallery-lightbox__image"
      id="gallery-lightbox-image"
      src=""
      alt="Inside Donkams Computers"
    />
  </div>
</BaseLayout>

<script>
  const galleryButtons = document.querySelectorAll(
    '.gallery-photo-button'
  );

  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImage = document.getElementById(
    'gallery-lightbox-image'
  );
  const closeButton = document.getElementById(
    'gallery-lightbox-close'
  );

  galleryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const image = button.getAttribute('data-gallery-image');

      if (!image || !lightbox || !lightboxImage) return;

      lightboxImage.src = image;

      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');

      document.body.style.overflow = 'hidden';
    });
  });

  const closeLightbox = () => {
    if (!lightbox || !lightboxImage) return;

    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');

    lightboxImage.src = '';

    document.body.style.overflow = '';
  };

  closeButton?.addEventListener('click', closeLightbox);

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeLightbox();
    }
  });
</script>