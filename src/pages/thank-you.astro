---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import '../styles/content.css';
---

<BaseLayout
  title="Thanks"
  description="Your message has been sent to Donkams."
  noIndex={true}
>
  <section class="notfound">
    <div class="container">
      <div class="notfound__inner">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none"
             stroke="#1F7A4D" stroke-width="1.5"
             stroke-linecap="round" stroke-linejoin="round"
             style="margin-bottom: var(--space-4);" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <path d="m8 12 3 3 5-6"/>
        </svg>

        <h1 class="notfound__title">Thanks — we'll be in touch.</h1>
        <p class="notfound__text">
          We usually respond within a few hours during business hours.
          For anything urgent, WhatsApp is the fastest way to reach us.
        </p>

        <div class="notfound__actions">
          <Button href="/" variant="primary" size="lg" icon="arrow">
            Back to Home
          </Button>
          <Button href="/products" variant="secondary" size="lg">
            Browse Products
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>